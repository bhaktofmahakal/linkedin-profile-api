# LinkedIn Authentication
# Use either email/password OR session cookie (LI_AT), not both

# Option 1: Email & Password (for full authenticated scraping)
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Option 2: LI_AT Cookie (session cookie from LinkedIn login)
# Get this by logging into LinkedIn and checking application cookies
LI_AT=your_li_at_cookie_value_here
# Optional: JSESSIONID cookie value from browser (e.g. ajax:1234567890)
JSESSIONID=ajax:your_jsessionid_here

# Application settings
APP_ENV=development
API_V1_STR=/api/v1
# Optional: Residential proxy URL
# PROXY_URL=http://user:pass@proxy.example.com:8080